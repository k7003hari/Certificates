  </filter-mapping>

<!-- all are the proxy listeners -->
  <listener>
    <listener-class>com.ebao.foundation.module.configframework.support.jsp.ServletContextListenerProxy</listener-class>
  </listener>
  <listener>
    <listener-class>com.ebao.foundation.module.configframework.support.jsp.HttpSessionListenerProxy</listener-class>
  </listener>

  <listener>
    <listener-class>com.ebao.foundation.module.configframework.support.jsp.HttpSessionAttributeListenerProxy</listener-class>
  </listener>
  <listener>
    <listener-class>com.ebao.foundation.module.configframework.support.jsp.ServletContextAttributeListenerProxy</listener-class>
  </listener>

  <servlet>
    <servlet-name>action</servlet-name>
    <servlet-class>com.ebao.foundation.module.web.struts.StrutsProxyServlet</servlet-class>
    <init-param>
      <param-name>debug</param-name>
      <param-value>2</param-value>
    </init-param>
    <init-param>
      <param-name>detail</param-name>
      <param-value>0</param-value>
    </init-param>
    <init-param>
      <param-name>validate</param-name>
      <param-value>true</param-value>
    </init-param>
    <load-on-startup>2</load-on-startup>
  </servlet>

  <servlet>
    <servlet-name>ConfigControllerService</servlet-name>
    <servlet-class>com.ebao.pub.soa.esb.servlet.CXFConfigControllerService</servlet-class>
    <load-on-startup>100</load-on-startup>
  </servlet>

  <servlet>
    <display-name>RootServlet</display-name>
    <servlet-name>rootservlet</servlet-name>

    <servlet-class>com.ebao.framework.RootServlet</servlet-class>
    <load-on-startup>3</load-on-startup>
  </servlet>

  <servlet>
    <servlet-name>dwr-invoker</servlet-name>
    <servlet-class>uk.ltd.getahead.dwr.DWRServlet</servlet-class>
    <init-param>
      <param-name>debug</param-name>
      <param-value>true</param-value>
    </init-param>
    <init-param>
      <param-name>logLevel</param-name>
      <param-value>DEBUG</param-value>
    </init-param>
  </servlet>
  <servlet-mapping>
    <servlet-name>dwr-invoker</servlet-name>
    <url-pattern>/dwr/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>initSystem</servlet-name>
    <servlet-class>com.ebao.pub.rms.init.RmsInitServlet</servlet-class>
    <init-param>
      <param-name>init_classes</param-name>
      <param-value>com.ebao.pub.rms.init.RmsInitImpl</param-value>
    </init-param>
    <load-on-startup>4</load-on-startup>
  </servlet>
  <servlet>
    <display-name>AjaxActionsServlet</display-name> 
    <servlet-name>ajaxActionsServlet</servlet-name> 
    <servlet-class>com.ebao.common.party.util.AjaxActionsServlet</servlet-class> 
    <load-on-startup>3</load-on-startup> 
       </servlet>
  <servlet-mapping>
      <servlet-name>ajaxActionsServlet</servlet-name> 
      <url-pattern>/ajaxActions</url-pattern> 
    </servlet-mapping>

  <servlet-mapping>
    <servlet-name>rootservlet</servlet-name>
    <url-pattern>/gs/servlet/*</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>action</servlet-name>
    <url-pattern>*.do</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>ConfigControllerService</servlet-name>
    <url-pattern>/services/*</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>rootservlet</servlet-name>
    <url-pattern>/gs/servlet/*</url-pattern>
  </servlet-mapping>

  <session-config>
    <!-- Default to 5 minute session timeouts -->
    <session-timeout>-1</session-timeout>
  </session-config>

  <mime-mapping>
    <extension>wsdl</extension>
    <mime-type>text/xml</mime-type>
  </mime-mapping>


  <mime-mapping>
    <extension>xsd</extension>
    <mime-type>text/xml</mime-type>
  </mime-mapping>



  <!-- The Usual Welcome File List -->
  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>
</web-app>
