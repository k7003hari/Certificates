<!-- performance tuning begin...-->

<filter>
    <filter-name>DynamicDataInit</filter-name>
    <filter-class>
      com.ebao.gs.pol.core.pub.dynamic.fwk.impl.DynamicDataInit
    </filter-class>
      <init-param>
            <param-name>ignoreURIs</param-name>
            <param-value></param-value>
         </init-param>
  </filter>

  <filter-mapping>
    <filter-name>DynamicDataInit</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>


<!-- performance tuning end...-->


  <filter>
    <filter-name>ProfileFilter</filter-name>
    <filter-class>
      com.ebao.foundation.module.web.filter.ProfileFilter
