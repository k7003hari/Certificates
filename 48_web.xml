    </filter-class>
  </filter>

  <filter>
    <filter-name>RootFilter</filter-name>
    <filter-class>com.ebao.framework.RootFilter</filter-class>
  </filter>


  <filter-mapping>
    <filter-name>SetCharacterEncodingFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <filter-mapping>
    <filter-name>ResourceCleanFilter</filter-name>
    <url-pattern>/*</url-pattern>
    <dispatcher>REQUEST</dispatcher>
  </filter-mapping>

